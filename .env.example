# ==============================================================================
# AgroShift NASA - Environment Variables
# Copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# [Optional / Recommended] Google Gemini 2.5 Flash via Google AI Studio
# Generates agronomic field action plans strictly grounded on NASA POWER,
# MODIS NDVI, and FAO data.
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
# Note: GOOGLE_API_KEY is also accepted as an alias.
# GOOGLE_API_KEY=

# [Optional] Meteomatics Weather API Credentials
# Enables the 7-day weather forecast panel in Step 2.
# Free trial signup: https://www.meteomatics.com/en/api/getting-started/
METEOMATICS_USER=
METEOMATICS_PASS=
